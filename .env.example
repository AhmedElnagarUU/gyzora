# ─── Gzora environment template ─────────────────────────────
# Copy to `.env` and fill in real values. Never commit `.env`.
# Validated at startup by `shared/lib/env.ts` (DEC-008). Empty values for
# optional keys are treated as "not set". Required keys must be non-empty.

# ─── Required ────────────────────────────────────────────────
# MongoDB connection string (server-only).
MONGODB_URI=mongodb://localhost:27017
# Better Auth signing secret (server-only; use a long random string).
BETTER_AUTH_SECRET=

# ─── Database (optional) ────────────────────────────────────
# Database name for Mongoose. Omitted when the URI already includes a name.
MONGODB_DB_NAME=gyzora

# ─── Auth (better-auth) ─────────────────────────────────────
# Public base URL used to build auth links (defaults to http://localhost:3000).
BETTER_AUTH_URL=http://localhost:3000

# ─── Storage (Amazon S3) — optional; needed for media uploads ─
# All four are required together; the S3 client fails fast if any is missing.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: custom public CDN/domain prefix for S3 objects.
S3_PUBLIC_BASE_URL=

# ─── Optional integrations (app runs without these) ─────────
# Pexels images (server-only, M-017).
PEXELS_API_KEY=

# Polar billing / subscriptions (not read yet).
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID_PRO=
POLAR_SERVER=

# AI provider (OpenAI-compatible — OpenRouter).
AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=inclusionai/ling-3.0-flash-sante:free

# Legacy Gemini key (not read yet).
GEMINI_KEY=

# ─── Public / Client-side ────────────────────────────────────
# Only NEXT_PUBLIC_* may be read in client code (server-only secrets never).
NEXT_PUBLIC_APP_URL=http://localhost:3000